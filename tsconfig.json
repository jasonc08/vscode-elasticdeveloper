{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2021",
        "outDir": "out",
        "lib": [
            "es2021"
        ],
        "types": [
            "node",
            "mocha"
        ],
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "rootDir": "src"
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        ".vscode-test",
        "_probe",
        "out"
    ]
}