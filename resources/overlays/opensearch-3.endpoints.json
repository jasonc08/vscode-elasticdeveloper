{
    "opensearch.query_insights.live_queries": {
        "methods": ["GET"],
        "url": {
            "paths": ["/_insights/live_queries"]
        },
        "documentation": "https://opensearch.org/docs/latest/observing-your-data/query-insights/"
    },
    "opensearch.ml.agents": {
        "methods": ["GET", "POST", "PUT", "DELETE"],
        "url": {
            "paths": ["/_plugins/_ml/agents/_register", "/_plugins/_ml/agents/{agent_id}", "/_plugins/_ml/agents/_search"]
        },
        "documentation": "https://opensearch.org/docs/latest/ml-commons-plugin/api/agent-apis/"
    },
    "opensearch.ml.tools": {
        "methods": ["GET", "POST", "PUT", "DELETE"],
        "url": {
            "paths": ["/_plugins/_ml/tools/_register", "/_plugins/_ml/tools/{tool_id}", "/_plugins/_ml/tools/_search"]
        },
        "documentation": "https://opensearch.org/docs/latest/ml-commons-plugin/api/tools-apis/"
    },
    "opensearch.ml.connectors": {
        "methods": ["GET", "POST", "PUT", "DELETE"],
        "url": {
            "paths": ["/_plugins/_ml/connectors/_create", "/_plugins/_ml/connectors/{connector_id}", "/_plugins/_ml/connectors/_search"]
        },
        "documentation": "https://opensearch.org/docs/latest/ml-commons-plugin/api/connector-apis/"
    },
    "opensearch.ppl.query_v3": {
        "methods": ["POST"],
        "url": {
            "paths": ["/_plugins/_ppl", "/_plugins/_ppl/_explain"]
        },
        "documentation": "https://opensearch.org/docs/latest/search-plugins/sql/ppl/index/"
    }
}
